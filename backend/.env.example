# Server Configuration
PORT=8080
APP_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Security & Authentication
JWT_SECRET=ganti-dengan-secret-key-minimal-32-karakter-di-production

# PostgreSQL Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/klikin?sslmode=disable

# Supabase Integration (Opsional)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Midtrans Payment Gateway (Opsional jika dikonfigurasi via Pengaturan Platform Admin)
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key
MIDTRANS_IS_PRODUCTION=false

# SMTP Email Configuration (Opsional jika diatur via Pengaturan Platform Admin)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@klikin.id
SMTP_FROM_NAME=Klikin Notification

# Initial Seeder Configuration (Hanya aktif di non-production atau jika SEED_DEMO_DATA=true)
SEED_DEMO_DATA=false
ADMIN_SEED_EMAIL=admin@klikin.id
ADMIN_SEED_PASSWORD=
OWNER_SEED_EMAIL=owner@klikin.id
OWNER_SEED_PASSWORD=
