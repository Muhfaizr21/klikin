{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "eslint/no-undef": "error",
    "react/jsx-no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": "off",
    "react/set-state-in-effect": "off"
  }
}
