# Backend API Base URL (tanpa garis miring di akhir)
VITE_API_URL=http://localhost:8080/api

# Supabase Client Configuration (Realtime & OAuth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Midtrans Frontend Configuration (Opsional - otomatis disinkronkan dari Backend API)
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key
VITE_MIDTRANS_IS_PRODUCTION=false

# Tampilkan tombol Akun Demo Uji Coba di halaman Login (true untuk dev, false untuk production)
VITE_ENABLE_DEMO_ACCOUNTS=false

